# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Database. Locally it defaults to a file (data/primor.db). On Vercel use Turso:
# TURSO_DATABASE_URL=libsql://primor-xxxx.turso.io
# TURSO_AUTH_TOKEN=...

# One-time code to create the first IT account at /admin (24+ random characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_TOKEN=

# Email for customer login codes (https://resend.com). Without it, codes print to the dev console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Primor <no-reply@primor.cl>
