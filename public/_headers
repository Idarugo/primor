# HTTP security headers (Netlify and Cloudflare Pages read this file; Vercel uses vercel.json).
# The page-level CSP lives in a <meta> generated by Astro; the directives that only
# work as headers (frame-ancestors) are set here.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/cuenta
  Cache-Control: no-store

/tienda/checkout
  Cache-Control: no-store

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
