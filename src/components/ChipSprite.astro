---
// Three organic potato chip shapes, reused across the page with <use href="#chip-n" />.
// Wavy, irregular edges plus blister spots and highlights so they read as chips, not coins.
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <radialGradient id="chip-tone" cx="42%" cy="38%" r="70%">
      <stop offset="0" stop-color="#fff1bf" />
      <stop offset="0.55" stop-color="#f8d36a" />
      <stop offset="0.9" stop-color="#e9a93a" />
      <stop offset="1" stop-color="#c98426" />
    </radialGradient>
    <linearGradient id="chip-fold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
      <stop offset="1" stop-color="#8a5414" stop-opacity="0.25" />
    </linearGradient>
    <g id="chip-detail">
      <path d="M20 38 C38 30 60 34 82 30" fill="none" stroke="#fff6d6" stroke-width="2.4" stroke-linecap="round" opacity="0.55" />
      <path d="M16 58 C40 50 62 60 86 52" fill="none" stroke="#d99a34" stroke-width="1.6" stroke-linecap="round" opacity="0.45" />
      <g fill="#b8721c" opacity="0.5">
        <ellipse cx="36" cy="48" rx="3.2" ry="1.8" transform="rotate(-20 36 48)" />
        <ellipse cx="63" cy="66" rx="2.2" ry="1.4" />
        <ellipse cx="70" cy="40" rx="1.6" ry="1.1" />
        <circle cx="48" cy="74" r="1.3" />
      </g>
      <g fill="#fff8df" opacity="0.8">
        <circle cx="44" cy="34" r="1.6" />
        <circle cx="58" cy="50" r="1.1" />
        <circle cx="30" cy="62" r="1" />
      </g>
    </g>
  </defs>
  <symbol id="chip-1" viewBox="0 0 100 100">
    <path fill="url(#chip-tone)" d="M12 46c-2-14 8-28 22-34 8-4 14-1 22-4 10-3 20 2 27 10 7 7 6 15 9 23 3 9 0 18-6 25-5 6-6 13-14 17-9 5-18 2-27 5-10 3-20-2-26-10-5-6-3-13-6-20-2-4-1-8-1-12Z" />
    <path fill="url(#chip-fold)" d="M12 46c-2-14 8-28 22-34 8-4 14-1 22-4 10-3 20 2 27 10 7 7 6 15 9 23 3 9 0 18-6 25-5 6-6 13-14 17-9 5-18 2-27 5-10 3-20-2-26-10-5-6-3-13-6-20-2-4-1-8-1-12Z" />
    <use href="#chip-detail" />
  </symbol>
  <symbol id="chip-2" viewBox="0 0 100 100">
    <path fill="url(#chip-tone)" d="M8 52c0-12 6-22 16-30 9-7 18-8 28-10 12-2 24 0 33 8 6 6 8 14 8 22 1 10-4 17-10 24-7 8-15 13-26 15-10 2-21 1-30-5C14 71 8 63 8 52Z" />
    <path fill="url(#chip-fold)" d="M8 52c0-12 6-22 16-30 9-7 18-8 28-10 12-2 24 0 33 8 6 6 8 14 8 22 1 10-4 17-10 24-7 8-15 13-26 15-10 2-21 1-30-5C14 71 8 63 8 52Z" transform="rotate(30 50 50)" />
    <use href="#chip-detail" transform="rotate(14 50 50)" />
  </symbol>
  <symbol id="chip-3" viewBox="0 0 100 100">
    <path fill="url(#chip-tone)" d="M18 30c6-10 18-16 30-17 9-1 15 4 23 5 9 2 16 8 18 17 2 8-2 14-1 22 1 9-5 17-13 21-9 5-17 9-27 8-11-1-20-7-26-16-5-8-5-16-6-24-1-6-1-11 2-16Z" />
    <path fill="url(#chip-fold)" d="M18 30c6-10 18-16 30-17 9-1 15 4 23 5 9 2 16 8 18 17 2 8-2 14-1 22 1 9-5 17-13 21-9 5-17 9-27 8-11-1-20-7-26-16-5-8-5-16-6-24-1-6-1-11 2-16Z" transform="rotate(-40 50 50)" />
    <use href="#chip-detail" transform="rotate(-18 50 50)" />
  </symbol>
</svg>
