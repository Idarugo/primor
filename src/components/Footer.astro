---
import { INSTAGRAM_URL, FACEBOOK_URL, MAPS_URL, FOUNDED, address } from '../data/site';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Tienda',
    links: [
      { href: '/tienda', label: 'Todos los productos' },
      { href: '/tienda?c=cajas', label: 'Cajas y promociones' },
      { href: '/tienda?c=papas', label: 'Papas fritas' },
      { href: '/tienda?c=ramitas', label: 'Ramitas' },
      { href: '/tienda?c=sufles', label: 'Suflés' },
      { href: '/tienda?c=mani', label: 'Maní' },
      { href: '/arma-tu-caja', label: 'Arma tu caja' },
    ],
  },
  {
    title: 'Primor',
    links: [
      { href: '/#historia', label: 'Nuestra historia' },
      { href: '/#productos', label: 'La familia Primor' },
      { href: '/#comunidad', label: 'Comunidad' },
      { href: '/#visitanos', label: 'Preguntas frecuentes' },
    ],
  },
  {
    title: 'Ayuda',
    links: [
      { href: '/cuenta', label: 'Mi cuenta' },
      { href: '/cuenta#pedidos', label: 'Mis pedidos' },
      { href: '/contacto', label: 'Contacto' },
      { href: '/contacto?tipo=negocio', label: 'Ventas a negocios' },
    ],
  },
];
const social = [
  {
    href: INSTAGRAM_URL,
    label: 'Instagram de Primor',
    d: 'M128 80a48 48 0 1 0 48 48 48.05 48.05 0 0 0-48-48Zm0 80a32 32 0 1 1 32-32 32 32 0 0 1-32 32Zm48-136H80a56.06 56.06 0 0 0-56 56v96a56.06 56.06 0 0 0 56 56h96a56.06 56.06 0 0 0 56-56V80a56.06 56.06 0 0 0-56-56Zm40 152a40 40 0 0 1-40 40H80a40 40 0 0 1-40-40V80a40 40 0 0 1 40-40h96a40 40 0 0 1 40 40Zm-24-100a12 12 0 1 1-12-12 12 12 0 0 1 12 12Z',
  },
  {
    href: FACEBOOK_URL,
    label: 'Facebook de Primor',
    d: 'M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm8 191.63V152h24a8 8 0 0 0 0-16h-24v-24a16 16 0 0 1 16-16h16a8 8 0 0 0 0-16h-16a32 32 0 0 0-32 32v24H96a8 8 0 0 0 0 16h24v63.63a88 88 0 1 1 16 0Z',
  },
];
const link = 'body-6 text-cream/60 transition-colors duration-300 ease-out-soft hover:text-cream focus-visible:outline-2 focus-visible:outline-yellow';
---

<footer class="bg-ink text-cream" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Pie de página</h2>
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-8 sm:pt-24">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr_1fr] lg:gap-16">
      <!-- Brand -->
      <div>
        <a href="/" aria-label="Primor, ir al inicio" class="inline-block rounded-xl bg-cream px-4 py-3">
          <img src="/img/logo.webp" alt="Primor snacks" width="140" height="64" loading="lazy" class="h-10 w-auto" />
        </a>
        <p class="body-6 mt-6 max-w-xs text-cream/60">Papas fritas caseras y artesanales de Rancagua, en la mesa de la familia chilena desde {FOUNDED}.</p>
        <ul class="mt-6 flex gap-2">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="grid size-10 place-items-center rounded-full ring-1 ring-cream/15 transition-colors duration-300 ease-out-soft hover:bg-cream hover:text-ink focus-visible:outline-2 focus-visible:outline-yellow">
                <svg aria-hidden="true" viewBox="0 0 256 256" class="size-5" fill="currentColor"><path d={s.d} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Link columns -->
      <nav aria-label="Enlaces del pie de página" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((c) => (
          <div>
            <p class="caption-3 text-cream/40">{c.title}</p>
            <ul class="mt-4 grid gap-3">
              {c.links.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Visit -->
      <div>
        <p class="caption-3 text-cream/40">Sala de venta</p>
        <address class="body-6 mt-4 not-italic text-cream/80">{address.street}<br />{address.city}, Chile</address>
        <p class="body-6 mt-3 text-cream/60">{address.hours}</p>
        <a href={MAPS_URL} target="_blank" rel="noopener" class="button-sm mt-4 inline-flex items-center gap-2 text-yellow underline-offset-4 hover:underline">Cómo llegar →</a>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-cream/10 py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="caption-5 text-cream/40">© {year} Primor Snacks · Rancagua, Chile</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href="/privacidad" class="caption-5 text-cream/40 hover:text-cream">Política de privacidad</a></li>
        <li><a href="/terminos" class="caption-5 text-cream/40 hover:text-cream">Términos y condiciones</a></li>
      </ul>
    </div>
  </div>
</footer>
