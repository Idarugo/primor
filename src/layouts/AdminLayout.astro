---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'Panel · Primor' } = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-[#f6f3ec] font-sans text-ink">
    <slot />
  </body>
</html>
