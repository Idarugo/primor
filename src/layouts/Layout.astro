---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ChipSprite from '../components/ChipSprite.astro';
import CartDrawer from '../components/shop/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import Announcement from '../components/Announcement.astro';

interface Props {
  title?: string;
  description?: string;
  /** Light pages (the store) sit on cream so white product photos blend in. */
  theme?: 'dark' | 'light';
  /** Home page only: smooth scroll + scrollytelling timelines. */
  story?: boolean;
}

const {
  title = 'Primor · Papas fritas caseras desde 1973',
  description = 'Papas fritas caseras y artesanales de Rancagua. Papas hilo, ramitas, suflés y maní Primor, acompañando a la familia chilena desde 1973.',
  theme = 'dark',
  story = false,
} = Astro.props;
const ogImage = new URL('/img/og.jpg', Astro.site ?? 'https://primor.cl').href;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131209" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    {story && <link rel="preload" as="image" href="/img/bag-230.webp" />}
  </head>
  <body class:list={['font-sans', theme === 'light' ? 'bg-cream text-ink' : 'bg-ink text-cream']}>
    <a href="#main" class="btn btn-primary fixed top-4 left-4 z-[100] -translate-y-24 focus:translate-y-0">Saltar al contenido</a>
    <ChipSprite />
    <Announcement />
    <Nav />
    <CartDrawer />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {story && <script src="../scripts/story.ts"></script>}
  </body>
</html>
